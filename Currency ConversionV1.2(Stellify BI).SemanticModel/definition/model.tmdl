model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Origin DataSet'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup DimensionsTables

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["TradingData1","Grades","Purchase Currency","Dates","Sale Currency","Suppliers","Buyers","Hauliers","Haulage Currency","Acount Managers","Collection Types","Query1","Sales  Measures","Trading","US Dollar Rates","Euro Rates","British Pound Rates","Currency Rates","Currency Slicer","Purchases Measures","Profits Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Grades
ref table 'Purchase Currency'
ref table 'Sale Currency'
ref table Suppliers
ref table Buyers
ref table Hauliers
ref table 'Haulage Currency'
ref table 'Acount Managers'
ref table 'Collection Types'
ref table Dates
ref table 'Sales  Measures'
ref table Trading
ref table 'Currency Rates'
ref table 'Currency Slicer'
ref table 'Purchases Measures'
ref table 'Profits Measures'

ref cultureInfo en-US

