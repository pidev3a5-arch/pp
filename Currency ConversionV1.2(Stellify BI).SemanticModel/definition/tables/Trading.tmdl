	column 'Missing Currency' =
			
			IF(ISBLANK(Trading[SC_ID]) ||ISBLANK(Trading[PC_ID])||ISBLANK(Trading[HC_ID]),"MC","AC")
		lineageTag: e7d8a8b1-58a4-42fc-b627-da7dca8e1352
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Sales(USD) = ```
			
			var _to= "-USD"
			var _c = CONCATENATE(RELATED('Sale Currency'[SC]),_to)
			var _rate=
			IF(RELATED('Sale Currency'[SC])="US Dollar" ,1,
			LOOKUPVALUE('Currency Rates'[From],'Currency Rates'[Currency],_c)
			)
			return 
			Trading[Est Weight] * Trading[Unit Sales Price] * _rate
			```
		formatString: #,0.00
		lineageTag: bff3ddbe-852d-4490-8108-49b1964af70a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Sales(Euro) = ```
			
			var _to= "-EUR"
			var _c = CONCATENATE(RELATED('Sale Currency'[SC]),_to)
