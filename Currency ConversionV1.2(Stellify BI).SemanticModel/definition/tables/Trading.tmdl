	column 'Days Till Load' = DATEDIFF(Trading[Est Load Date],Trading[Delivery Date],DAY)
		formatString: 0
		lineageTag: cc0e0a4c-93f1-4db3-aaae-995a4b362aed
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Product load' =
			
			CALCULATE(SUM([Days Till Load]),ALLEXCEPT(Trading,Trading[GradeID])
			)
		formatString: 0
		lineageTag: c173944b-bb0c-4a39-985e-5522be321899
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Missing Purchases Unit' =
			
