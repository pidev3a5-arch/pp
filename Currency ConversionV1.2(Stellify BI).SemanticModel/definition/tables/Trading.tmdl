		formatString: #,0.00
		lineageTag: d70ca682-a66f-4c80-9c33-5a0ed13c2842
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DC = ```
			
			var _c = 
			RELATED('Sale Currency'[SC])
			return
			SWITCH(TRUE(),
			_c= "British Pound","£",
			_c= "US Dollar","$",
			_c= "Euro","€"
			)
			```
		lineageTag: 0a96e2fd-7a5c-446a-971b-30c20353346a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

