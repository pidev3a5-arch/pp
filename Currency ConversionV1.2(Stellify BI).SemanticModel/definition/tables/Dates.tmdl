	column 'Start of Month'
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: beb232a1-a1b7-4679-9d5a-7c2d22765a96
		summarizeBy: none
		sourceColumn: Start of Month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'Include Dates' =
			
			VAR EarliestDate = MIN( Trading[Confirmed Load Date] )
			VAR LatestDate = MAX( Trading[Delivery Date] )
			
			RETURN
			IF( AND( Dates[Date] > EarliestDate , Dates[Date] < LatestDate ), TRUE(), FALSE() )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 207f7f45-337d-4e7a-913a-4efc13a2ecaf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

