	partition Dates-8a957507-8e00-4a4d-914c-c3aec5af6c75 = m
		mode: import
		queryGroup: DimensionsTables
		source =
				let
				    Source = Query1(#date(2019, 1, 1), #date(2020, 12, 31), null, null, null),
				    #"Inserted Start of Month" = Table.AddColumn(Source, "Start of Month", each Date.StartOfMonth([Date]), type date),
				    #"Inserted Month" = Table.AddColumn(#"Inserted Start of Month", "Month", each Date.Month([Date]), Int64.Type)
				in
				    #"Inserted Month"

	annotation PBI_ResultType = Table

